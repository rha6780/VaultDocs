# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=vaultdocs
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://vaultdocs:your_secure_password_here@localhost:5432/vaultdocs

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_here_min_32_chars

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console > APIs & Services > Credentials 에서 발급
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ─── MinIO (로컬 오브젝트 스토리지) ───────────────────────────────────────────
MINIO_ROOT_USER=vaultdocs
MINIO_ROOT_PASSWORD=your_minio_password_here
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=vaultdocs
MINIO_SECRET_KEY=your_minio_password_here
MINIO_BUCKET=vaultdocs

# ─── App ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000
